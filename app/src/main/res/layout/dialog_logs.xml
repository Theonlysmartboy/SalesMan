<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_activity"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="@dimen/_4dp"/>

        <TextView
            android:id="@+id/tvLastActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="@dimen/_8dp"
            android:text="@string/none"
            android:fontFamily="monospace"
            android:textSize="@dimen/_12sp"
            android:layout_marginBottom="@dimen/_16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_system_log"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="@dimen/_4dp"/>

        <TextView
            android:id="@+id/tvLastSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="@dimen/_8dp"
            android:text="@string/none"
            android:fontFamily="monospace"
            android:textSize="@dimen/_12sp"
            android:layout_marginBottom="@dimen/_16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_request"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="@dimen/_4dp"/>

        <TextView
            android:id="@+id/tvLastRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="@dimen/_8dp"
            android:text="@string/no_request_yet"
            android:fontFamily="monospace"
            android:textSize="@dimen/_12sp"
            android:layout_marginBottom="@dimen/_16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/last_response"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingBottom="@dimen/_4dp"/>

        <TextView
            android:id="@+id/tvLastResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:padding="@dimen/_8dp"
            android:text="@string/no_response_yet"
            android:fontFamily="monospace"
            android:textSize="@dimen/_12sp"/>

    </LinearLayout>
</ScrollView>