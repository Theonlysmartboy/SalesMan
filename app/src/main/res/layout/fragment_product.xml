<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/honeydew">
    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/productToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:title="@string/products"
        app:titleTextColor="@color/honeydew"
        app:menu="@menu/menu_product_search" />

    <!-- Selected Customer Header -->
    <TextView
        android:id="@+id/tvSelectedCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dust_gray"
        android:padding="@dimen/_12dp"
        android:text="@string/select_customer"
        android:textColor="@color/black"
        android:textSize="@dimen/_16sp"
        android:textStyle="bold"
        android:drawablePadding="@dimen/_8dp"
        android:gravity="center_vertical"
        android:visibility="gone"/>

    <!-- Pull to refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/productSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/productRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <com.js.salesman.utils.TrailingDotsLoader
            android:id="@+id/progressLoader"
            android:layout_width="@dimen/_100dp"
            android:layout_height="@dimen/_100dp"
            android:layout_gravity="center"
            app:dotCount="8"
            app:dotRadius="10dp"
            app:primaryColor="@color/teal_700"
            app:secondaryColor="@color/aquamarine"
            app:animationDuration="1000"
            android:visibility="gone" />

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
