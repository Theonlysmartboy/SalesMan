<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_24dp"
    app:cardCornerRadius="@dimen/_20dp"
    app:cardElevation="@dimen/_8dp"
    android:background="@color/honeydew">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="@dimen/_72dp"
            android:layout_height="@dimen/_72dp"
            android:src="@drawable/ic_no_internet"
            android:contentDescription="@string/error"/>

        <TextView
            android:layout_marginTop="@dimen/_16dp"
            android:text="@string/no_internet_connection"
            android:textStyle="bold"
            android:textSize="@dimen/_18sp"
            android:textColor="@color/royal_blue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_marginTop="@dimen/_8dp"
            android:text="@string/please_enable_wi_fi_or_mobile_data_to_continue"
            android:gravity="center"
            android:textColor="@color/gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnProceedOffline"
                style="@style/Widget.Material3.Button"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/_8dp"
                android:text="@string/proceed_offline"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnEnableInternet"
                style="@style/Widget.Material3.Button"
                android:text="@string/enable_internet"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="@string/retry"
                    android:textColor="@color/royal_blue"/>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnExit"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_marginStart="@dimen/_16dp"
                    android:text="@string/exit"
                    android:textColor="@color/royal_blue"/>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>