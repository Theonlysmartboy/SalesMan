<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="@dimen/_8dp">

    <ImageView
        android:id="@+id/parked_cart_icon"
        android:layout_width="@dimen/_24dp"
        android:layout_height="@dimen/_24dp"
        android:src="@drawable/ic_baseline_shopping_basket_24"
        android:contentDescription="@string/parked_carts" />

    <TextView
        android:id="@+id/parked_cart_badge"
        android:layout_width="@dimen/_18dp"
        android:layout_height="@dimen/_18dp"
        android:layout_alignEnd="@id/parked_cart_icon"
        android:layout_marginTop="@dimen/_n4dp"
        android:layout_marginEnd="@dimen/_n4dp"
        android:background="@drawable/ic_badge_circle"
        android:backgroundTint="@color/egyptian_blue"
        android:textColor="@color/white"
        android:textSize="@dimen/_11sp"
        android:gravity="center"
        android:text="@string/_0"
        android:visibility="gone"/>
</RelativeLayout>
