<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.auth.LockActivity"
    android:padding="@dimen/_24dp"
    android:background="@color/honeydew">

    <!-- Top Guideline for responsiveness -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/_80dp" />

    <!-- Logo / Lottie -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="@dimen/_120dp"
        android:layout_height="@dimen/_120dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Icon -->
    <ImageView
        android:id="@+id/lockIcon"
        android:layout_width="@dimen/_80dp"
        android:layout_height="@dimen/_80dp"
        android:src="@drawable/biometricunlock_outline"
        android:contentDescription="@string/biometric_lock_icon"
        app:layout_constraintTop_toBottomOf="@+id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- Title -->
        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:id="@+id/tvTitle"
            android:text="@string/app_locked"
            android:textSize="@dimen/_22sp"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_4dp"
            android:fontFamily="@font/roboto_medium"
            app:layout_constraintTop_toBottomOf="@+id/lockIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:id="@+id/tvSubtitle"
            android:text="@string/use_fingerprint_or_pin_to_unlock"
            android:textColor="@color/gray"
            android:textSize="@dimen/_14sp"
            android:fontFamily="@font/roboto_medium"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/pinContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnFingerprint">

        <EditText
            android:id="@+id/pin1"
            style="@style/PinBox"
            android:hint="@string/pin_digit_1"
            android:autofillHints=""
            android:textColorHint="@color/transparent"/>

        <EditText
            android:id="@+id/pin2"
            style="@style/PinBox"
            android:hint="@string/pin_digit_2"
            android:autofillHints=""
            android:textColorHint="@color/transparent"/>

        <EditText
            android:id="@+id/pin3"
            style="@style/PinBox"
            android:hint="@string/pin_digit_3"
            android:autofillHints=""
            android:textColorHint="@color/transparent"/>

        <EditText
            android:id="@+id/pin4"
            style="@style/PinBox"
            android:hint="@string/pin_digit_4"
            android:autofillHints=""
            android:textColorHint="@color/transparent"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFingerprint"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/use_fingerprint"
        android:textColor="@color/teal_700"
        android:fontFamily="@font/roboto_midi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pinContainer"
        app:layout_constraintBottom_toTopOf="@+id/btnUnlock"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_20dp"
            android:text="@string/unlock"
            android:textColor="@color/honeydew"
            android:fontFamily="@font/roboto_midi"
            android:background="@drawable/rounded_primary_button"
            app:backgroundTint="@null"
            app:shapeAppearanceOverlay="@null"
            app:rippleColor="@android:color/transparent"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnFingerprint"
            app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>