<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/teal_700"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/_12dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvBannerBusinessName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/active_visit"
            android:textColor="@color/honeydew"
            android:textSize="@dimen/_16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvBannerVisitId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/visit_100003"
            android:textColor="@color/honeydew"
            android:textSize="@dimen/_12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvBannerElapsedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_00_00_00"
            android:textColor="@color/honeydew"
            android:textSize="@dimen/_16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvBannerSyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pending"
            android:textColor="@color/light_yellow_200"
            android:textSize="@dimen/_12sp" />
    </LinearLayout>
</LinearLayout>
