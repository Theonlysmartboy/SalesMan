<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Auto Backup to Google Drive (Android 12+) -->
    <cloud-backup>
        <!--
            Denylist mode: everything is backed up EXCEPT the entries below.
            Only add <include> tags if you switch to allowlist mode deliberately.
        -->
        <!--
            Device-bound session: token, expiry, selected customer, cached GPS.
            Never restore on a new device — re-auth against the server instead. -->
        <exclude domain="sharedpref" path="salesman_session.xml" />
        <!-- Regenerable caches and diagnostics -->
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="cache/" />
        <!-- External files are user-visible; don't silently sync them -->
        <exclude domain="external" path="." />
    </cloud-backup>

    <!-- Direct device-to-device migration (Android 12+) -->
    <device-transfer>
        <exclude domain="sharedpref" path="salesman_session.xml" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>