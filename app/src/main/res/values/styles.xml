<resources>

    <style name="Widget.Theme.SalesMan.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Widget.Theme.SalesMan.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>
    <style name="NavigationHeaderText">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/_12sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="DrawerHeaderStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">@dimen/_12sp</item>
        <item name="android:textColor">?attr/colorSecondary</item>
    </style>
    <style name="PinBox">
        <item name="android:layout_width">@dimen/_48dp</item>
        <item name="android:layout_height">@dimen/_48dp</item>
        <item name="android:layout_margin">@dimen/_6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/_18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:inputType">numberPassword</item>
        <item name="android:maxLength">1</item>
        <item name="android:background">@drawable/pin_box_bg</item>
    </style>
    <!-- SECTION HEADER -->
    <style name="SectionHeader">
        <item name="android:textSize">@dimen/_14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingTop">@dimen/_8dp</item>
        <item name="android:paddingBottom">@dimen/_4dp</item>
    </style>

    <!-- SETTINGS CARD -->
    <style name="SettingsCard">
        <item name="cardCornerRadius">@dimen/_12dp</item>
        <item name="cardElevation">@dimen/_3dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardBackgroundColor">@android:color/white</item>
    </style>

    <!-- DIVIDER -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_1dp</item>
        <item name="android:background">@color/gray</item>
        <item name="android:layout_marginStart">@dimen/_8dp</item>
        <item name="android:layout_marginEnd">@dimen/_8dp</item>
    </style>
</resources>